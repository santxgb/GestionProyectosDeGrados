<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1160.0" prefHeight="860.0" fx:controller="co.edu.uptc.controller.fx.DocumentFxController" style="-fx-font-family: System; -fx-font-size: 13px; -fx-background-color: #F5F5F5; -fx-focus-color: #D0A00F; -fx-faint-focus-color: rgba(208,160,15,0.15);">
    <top>
        <VBox spacing="6.0" style="-fx-background-color: #FFCC29; -fx-border-color: transparent transparent #E4B11D transparent; -fx-border-width: 0 0 3 0;">
            <padding><Insets top="20.0" right="28.0" bottom="20.0" left="28.0"/></padding>
            <children>
                <Label text="Propuestas y expedientes" style="-fx-text-fill: #212121; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Label text="Radicación, consulta y decisiones del Comité Curricular" wrapText="true" style="-fx-text-fill: #363636;"/>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" style="-fx-background-color: #F5F5F5; -fx-background: #F5F5F5;">
            <content>
                <VBox spacing="18.0" style="-fx-background-color: #F5F5F5;">
                    <padding><Insets top="22.0" right="26.0" bottom="22.0" left="26.0"/></padding>
                    <children>
                        <VBox spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 9; -fx-border-color: #DEDEDE; -fx-border-width: 1; -fx-border-radius: 9;">
                            <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/></padding>
                            <children>
                                <Label text="Radicar o editar una propuesta" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                                    <font><Font name="System Bold" size="18.0"/></font>
                                </Label>
                                <Label text="Para radicar, registra primero estudiantes y docentes. Para modificar o eliminar, selecciona una propuesta en revisión en la tabla y pulsa Cargar para editar." wrapText="true" style="-fx-text-fill: #5C5C5C;"/>
                                <Label fx:id="editModeLabel" text="Modo: radicar una propuesta nueva" style="-fx-text-fill: #353535; -fx-font-weight: bold;"/>
                                <GridPane hgap="12.0" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="140.0" prefWidth="160.0"/>
                                        <ColumnConstraints minWidth="210.0" hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="145.0" prefWidth="170.0"/>
                                        <ColumnConstraints minWidth="210.0" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <children>
                                        <Label text="ID del expediente" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="idField" promptText="Ej. P-2026-001" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Label text="Título" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="titleField" promptText="Título de la propuesta" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>

                                        <Label text="Modalidad" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <ComboBox fx:id="modalityCombo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Label text="Fecha de radicación" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-text-fill: #252525;"/>
                                        <DatePicker fx:id="filingDatePicker" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>

                                        <Label text="Estudiante 1 (código)" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="student1Field" promptText="Obligatorio" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Label text="Estudiante 2 (código)" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="student2Field" promptText="Opcional" GridPane.rowIndex="2" GridPane.columnIndex="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>

                                        <Label text="Director (ID)" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="directorField" promptText="Identificación del docente" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Label text="Codirector (ID)" GridPane.rowIndex="3" GridPane.columnIndex="2" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="codirectorField" promptText="Opcional" GridPane.rowIndex="3" GridPane.columnIndex="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>

                                        <Label text="Empresa / entidad" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="companyField" promptText="Solo para práctica empresarial o social; opcional" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>

                                        <Label text="Observaciones iniciales" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <TextArea fx:id="observationsField" promptText="Observaciones de la propuesta (opcional)" prefRowCount="2" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                    </children>
                                </GridPane>
                                <VBox spacing="9.0">
                                    <children>
                                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Button text="Radicar propuesta" onAction="#onRegister" mnemonicParsing="false" style="-fx-background-color: #FFCC29; -fx-background-radius: 6; -fx-border-color: #E3B321; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #212121; -fx-cursor: hand; -fx-padding: 7 13 7 13; -fx-font-weight: bold;"/>
                                                <Button text="Limpiar formulario" onAction="#onClear" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Button text="Cargar para editar" onAction="#onLoadForEdit" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                                                <Button text="Actualizar propuesta" onAction="#onUpdate" mnemonicParsing="false" style="-fx-background-color: #FFCC29; -fx-background-radius: 6; -fx-border-color: #E3B321; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #212121; -fx-cursor: hand; -fx-padding: 7 13 7 13; -fx-font-weight: bold;"/>
                                                <Button text="Eliminar propuesta" onAction="#onDelete" mnemonicParsing="false" style="-fx-background-color: #FFF1F0; -fx-background-radius: 6; -fx-border-color: #D99A94; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #952E27; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 9; -fx-border-color: #DEDEDE; -fx-border-width: 1; -fx-border-radius: 9;">
                            <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/></padding>
                            <children>
                                <Label text="Consultar expedientes" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                                    <font><Font name="System Bold" size="18.0"/></font>
                                </Label>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="ID del expediente" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="searchIdField" promptText="Buscar por identificador" prefWidth="260.0" onAction="#onSearch" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Button text="Buscar" onAction="#onSearch" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                                        <Button text="Actualizar lista" onAction="#onRefresh" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                                    </children>
                                </HBox>
                                <Label text="La tabla muestra propuestas y trabajos de grado. Seleccionar una fila consulta su detalle; solo las propuestas En revisión pueden cargarse para modificar o eliminar." wrapText="true" style="-fx-text-fill: #5C5C5C;"/>
                                <TableView fx:id="documentTable" prefHeight="240.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6D6D6; -fx-border-width: 1; -fx-control-inner-background: #FFFFFF; -fx-control-inner-background-alt: #F7F7F7; -fx-selection-bar: #FFEDAE; -fx-selection-bar-non-focused: #FFEDAE; -fx-accent: #FFCC29; -fx-focus-color: #D0A00F;">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="ID" prefWidth="120.0"/>
                                        <TableColumn fx:id="titleColumn" text="Título" prefWidth="280.0"/>
                                        <TableColumn fx:id="modalityColumn" text="Modalidad" prefWidth="230.0"/>
                                        <TableColumn fx:id="stageColumn" text="Etapa" prefWidth="115.0"/>
                                        <TableColumn fx:id="statusColumn" text="Estado" prefWidth="166.0"/>
                                        <TableColumn fx:id="filingDateColumn" text="Radicación" prefWidth="105.0"/>
                                    </columns>
                                </TableView>
                                <Label text="Detalle del expediente seleccionado" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                                    <font><Font name="System Bold" size="15.0"/></font>
                                </Label>
                                <TextArea fx:id="detailsArea" editable="false" wrapText="true" prefRowCount="9" text="Selecciona un expediente para consultar sus datos." style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                            </children>
                        </VBox>

                        <!-- Formulario de decisiones: reutiliza DocumentController.registrarDecisionDocumento. -->
                        <VBox spacing="13.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 9; -fx-border-color: #DEDEDE; -fx-border-width: 1; -fx-border-radius: 9;">
                            <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/></padding>
                            <children>
                                <Label text="Decisión del Comité Curricular" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                                    <font><Font name="System Bold" size="18.0"/></font>
                                </Label>
                                <Label text="Selecciona una propuesta En revisión en la tabla anterior. Una aprobación genera automáticamente el trabajo de grado; la decisión no se puede deshacer desde esta pantalla." wrapText="true" style="-fx-text-fill: #5C5C5C;"/>
                                <Label fx:id="decisionSelectedLabel" text="Ningún expediente seleccionado." wrapText="true" style="-fx-text-fill: #353535; -fx-font-weight: bold;"/>
                                <GridPane hgap="12.0" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="145.0" prefWidth="165.0"/>
                                        <ColumnConstraints minWidth="240.0" hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="115.0" prefWidth="130.0"/>
                                        <ColumnConstraints minWidth="200.0" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <children>
                                        <Label text="Decisión" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <ComboBox fx:id="decisionCombo" promptText="Selecciona una decisión" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Label text="Fecha de decisión" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-text-fill: #252525;"/>
                                        <DatePicker fx:id="decisionDatePicker" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                        <Label text="Acta del Comité" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #252525;"/>
                                        <TextField fx:id="decisionActField" promptText="Ej. Acta 018-2026" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                    </children>
                                </GridPane>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="Registrar decisión" onAction="#onRegisterDecision" mnemonicParsing="false" style="-fx-background-color: #FFCC29; -fx-background-radius: 6; -fx-border-color: #E3B321; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #212121; -fx-cursor: hand; -fx-padding: 7 13 7 13; -fx-font-weight: bold;"/>
                                        <Button text="Limpiar decisión" onAction="#onClearDecision" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #47484B;">
            <padding><Insets top="12.0" right="26.0" bottom="12.0" left="26.0"/></padding>
            <children>
                <Label fx:id="statusLabel" text="Cargando expedientes..." wrapText="true" HBox.hgrow="ALWAYS" style="-fx-text-fill: #FFFFFF;"/>
                <Button fx:id="closeButton" text="Cerrar ventana" onAction="#onClose" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
