<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="690.0" prefWidth="940.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.controller.fx.MainFxController">
    <top>
        <VBox spacing="8.0" style="-fx-background-color: #143550;">
            <padding>
                <Insets top="28.0" right="36.0" bottom="28.0" left="36.0" />
            </padding>
            <children>
                <Label text="SisTG UPTC" textFill="WHITE">
                    <font><Font name="System Bold" size="30.0" /></font>
                </Label>
                <Label text="Sistema de seguimiento de propuestas y trabajos de grado"
                       textFill="#DDE9F2" wrapText="true">
                    <font><Font size="15.0" /></font>
                </Label>
                <Label text="Escuela de Ingeniería de Sistemas y Computación · Seccional Sogamoso"
                       textFill="#BBD1E1" wrapText="true" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="22.0" style="-fx-background-color: #F5F7FA;">
            <padding>
                <Insets top="34.0" right="36.0" bottom="28.0" left="36.0" />
            </padding>
            <children>
                <Label text="Bienvenido a SisTG" textFill="#143550">
                    <font><Font name="System Bold" size="25.0" /></font>
                </Label>
                <Label text="La interfaz JavaFX incorpora los módulos de estudiantes, docentes, propuestas, vencimientos, alertas, jurados y observaciones. Swing permanece disponible durante la migración."
                       textFill="#46596B" wrapText="true">
                    <font><Font size="15.0" /></font>
                </Label>
                <VBox spacing="14.0" style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-color: #DCE3EA; -fx-border-radius: 10;">
                    <padding>
                        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0" />
                    </padding>
                    <children>
                        <Label text="Módulos disponibles" textFill="#143550">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Gestiona estudiantes, docentes, propuestas, tablero, alertas, jurados y observaciones. Los demás módulos siguen en Swing."
                               textFill="#46596B" wrapText="true" />
                        <VBox spacing="10.0">
                            <children>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="Gestionar estudiantes (JavaFX)" onAction="#onOpenStudents"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                        <Button text="Gestionar docentes (JavaFX)" onAction="#onOpenTeachers"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                    </children>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="Radicar / consultar propuestas (JavaFX)" onAction="#onOpenDocuments"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                        <Button text="Tablero de vencimientos (JavaFX)" onAction="#onOpenDeadlineBoard"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                    </children>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="Consultar alertas (JavaFX)" onAction="#onOpenAlerts"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                        <Button text="Asignar / consultar jurados (JavaFX)" onAction="#onOpenJuries"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                    </children>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="Observaciones de seguimiento (JavaFX)" onAction="#onOpenObservations"
                                                mnemonicParsing="false" prefHeight="40.0"
                                                style="-fx-background-color: #143550; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 6;" />
                                    </children>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button fx:id="openSwingButton" text="Abrir sistema Swing"
                                                onAction="#onOpenSwing" mnemonicParsing="false"
                                                style="-fx-background-color: #F4B321; -fx-text-fill: #17364D; -fx-font-weight: bold; -fx-background-radius: 6;"
                                                prefHeight="40.0" />
                                        <Button text="Acerca de SisTG" onAction="#onAbout"
                                                mnemonicParsing="false" prefHeight="40.0" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <Label fx:id="statusLabel" text="JavaFX listo. Tus registros JSON no se modifican al abrir esta pantalla."
                               textFill="#4A6070" wrapText="true" />
                    </children>
                </VBox>
                <Label text="Módulos JavaFX: estudiantes, docentes, propuestas, tablero, alertas, jurados y observaciones."
                       textFill="#516273" wrapText="true" />
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-background-color: #E8EDF1;">
            <padding>
                <Insets top="12.0" right="36.0" bottom="12.0" left="36.0" />
            </padding>
            <children>
                <Label text="JavaFX · Estudiantes, docentes, propuestas, tablero, alertas, jurados y observaciones" textFill="#526B80" />
                <Button text="Cerrar JavaFX" onAction="#onCloseJavaFx" mnemonicParsing="false" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
