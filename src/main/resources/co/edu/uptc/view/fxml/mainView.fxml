<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="940.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.controller.fx.MainFxController">
    <top>
        <VBox spacing="8.0" style="-fx-background-color: #143550;">
            <padding>
                <Insets top="28.0" right="36.0" bottom="28.0" left="36.0" />
            </padding>
            <children>
                <Label text="SisTG UPTC" textFill="WHITE">
                    <font><Font name="System Bold" size="30.0" /></font>
                </Label>
                <Label text="Sistema de seguimiento de propuestas y trabajos de grado"
                       textFill="#DDE9F2" wrapText="true">
                    <font><Font size="15.0" /></font>
                </Label>
                <Label text="Escuela de Ingeniería de Sistemas y Computación · Seccional Sogamoso"
                       textFill="#BBD1E1" wrapText="true" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="22.0" style="-fx-background-color: #F5F7FA;">
            <padding>
                <Insets top="34.0" right="36.0" bottom="28.0" left="36.0" />
            </padding>
            <children>
                <Label text="Bienvenido a SisTG" textFill="#143550">
                    <font><Font name="System Bold" size="25.0" /></font>
                </Label>
                <Label text="Primera etapa de la migración a JavaFX. La aplicación Swing seguirá disponible mientras trasladamos las pantallas una por una."
                       textFill="#46596B" wrapText="true">
                    <font><Font size="15.0" /></font>
                </Label>
                <VBox spacing="14.0" style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-color: #DCE3EA; -fx-border-radius: 10;">
                    <padding>
                        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0" />
                    </padding>
                    <children>
                        <Label text="Acceder al sistema actual" textFill="#143550">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Continúa gestionando estudiantes, docentes, propuestas, trabajos de grado y alertas en las ventanas Swing existentes."
                               textFill="#46596B" wrapText="true" />
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="openSwingButton" text="Abrir sistema Swing"
                                        onAction="#onOpenSwing" mnemonicParsing="false"
                                        style="-fx-background-color: #F4B321; -fx-text-fill: #17364D; -fx-font-weight: bold; -fx-background-radius: 6;"
                                        prefHeight="40.0" />
                                <Button text="Acerca de SisTG" onAction="#onAbout"
                                        mnemonicParsing="false" prefHeight="40.0" />
                            </children>
                        </HBox>
                        <Label fx:id="statusLabel" text="JavaFX listo. Tus registros JSON no se modifican al abrir esta pantalla."
                               textFill="#4A6070" wrapText="true" />
                    </children>
                </VBox>
                <Label text="Próxima etapa: migración del módulo de estudiantes a un formulario FXML."
                       textFill="#516273" wrapText="true" />
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-background-color: #E8EDF1;">
            <padding>
                <Insets top="12.0" right="36.0" bottom="12.0" left="36.0" />
            </padding>
            <children>
                <Label text="Interfaz JavaFX · Primera entrega" textFill="#526B80" />
                <Button text="Cerrar JavaFX" onAction="#onCloseJavaFx" mnemonicParsing="false" />
            </children>
        </HBox>
    </bottom>
</BorderPane>