<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1220.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.controller.fx.DeadlineBoardFxController">
    <top>
        <VBox spacing="7.0" style="-fx-background-color: #143550;">
            <padding><Insets top="22.0" right="28.0" bottom="22.0" left="28.0"/></padding>
            <children>
                <Label text="Tablero de trabajos de grado" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0"/></font>
                </Label>
                <Label text="Seguimiento de trabajos aprobados, ordenados por proximidad de vencimiento."
                       textFill="#DCE8F1" wrapText="true"/>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="14.0" style="-fx-background-color: #F5F7FA;">
            <padding><Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="Trabajos aprobados" textFill="#143550" HBox.hgrow="ALWAYS">
                            <font><Font name="System Bold" size="19.0"/></font>
                        </Label>
                        <Button text="Actualizar tablero" onAction="#onRefresh" mnemonicParsing="false"
                                style="-fx-background-color: #F4B321; -fx-font-weight: bold; -fx-text-fill: #143550;"/>
                    </children>
                </HBox>
                <Label fx:id="summaryLabel" text="Cargando trabajos de grado..." textFill="#526B80" />
                <Label text="Los días negativos indican trabajos vencidos. Selecciona un expediente para consultar sus fechas y observaciones."
                       textFill="#526B80" wrapText="true"/>
                <TableView fx:id="boardTable" prefHeight="385.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="92.0"/>
                        <TableColumn fx:id="titleColumn" text="Título" prefWidth="244.0"/>
                        <TableColumn fx:id="modalityColumn" text="Modalidad" prefWidth="166.0"/>
                        <TableColumn fx:id="approvalDateColumn" text="Aprobación" prefWidth="112.0"/>
                        <TableColumn fx:id="earliestDateColumn" text="Presentación desde" prefWidth="130.0"/>
                        <TableColumn fx:id="deadlineColumn" text="Fecha máxima" prefWidth="112.0"/>
                        <TableColumn fx:id="remainingDaysColumn" text="Días restantes" prefWidth="105.0"/>
                        <TableColumn fx:id="deadlineStatusColumn" text="Estado del plazo" prefWidth="180.0"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay trabajos de grado aprobados para mostrar." textFill="#526B80"/>
                    </placeholder>
                </TableView>
                <VBox spacing="8.0" style="-fx-background-color: WHITE; -fx-border-color: #DCE3EA; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <padding><Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                    <children>
                        <Label text="Detalle del expediente seleccionado" textFill="#143550">
                            <font><Font name="System Bold" size="17.0"/></font>
                        </Label>
                        <TextArea fx:id="detailsArea" editable="false" wrapText="true" prefRowCount="6" prefHeight="150.0"
                                  promptText="Selecciona un trabajo de grado en la tabla para ver sus datos."/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="12.0" alignment="CENTER_LEFT" style="-fx-background-color: #E8EDF1;">
            <padding><Insets top="12.0" right="24.0" bottom="12.0" left="24.0"/></padding>
            <children>
                <Label fx:id="statusLabel" text="Cargando tablero..." textFill="#34495E"
                       wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button fx:id="closeButton" text="Cerrar ventana" onAction="#onClose"
                        mnemonicParsing="false"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
