<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefHeight="750.0" prefWidth="1220.0" fx:controller="co.edu.uptc.controller.fx.DeadlineBoardFxController" style="-fx-font-family: System; -fx-font-size: 13px; -fx-background-color: #F5F5F5; -fx-focus-color: #D0A00F; -fx-faint-focus-color: rgba(208,160,15,0.15);">
    <top>
        <VBox spacing="7.0" style="-fx-background-color: #FFCC29; -fx-border-color: transparent transparent #E4B11D transparent; -fx-border-width: 0 0 3 0;">
            <padding><Insets top="22.0" right="28.0" bottom="22.0" left="28.0"/></padding>
            <children>
                <Label text="Tablero de trabajos de grado" style="-fx-text-fill: #212121; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="26.0"/></font>
                </Label>
                <Label text="Seguimiento de trabajos aprobados, ordenados por proximidad de vencimiento." wrapText="true" style="-fx-text-fill: #363636;"/>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #F5F5F5; -fx-background: #F5F5F5;">
            <content>
                <VBox spacing="14.0" style="-fx-background-color: #F5F5F5;">
                    <padding><Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Trabajos aprobados" HBox.hgrow="ALWAYS" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                                    <font><Font name="System Bold" size="19.0"/></font>
                                </Label>
                                <Button text="Actualizar tablero" onAction="#onRefresh" mnemonicParsing="false" style="-fx-background-color: #FFCC29; -fx-background-radius: 6; -fx-border-color: #E3B321; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #212121; -fx-cursor: hand; -fx-padding: 7 13 7 13; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                        <Label fx:id="summaryLabel" text="Cargando trabajos de grado..." style="-fx-text-fill: #5C5C5C;"/>
                        <Label text="Los días negativos indican trabajos vencidos. Selecciona un expediente para consultar sus fechas y observaciones." wrapText="true" style="-fx-text-fill: #5C5C5C;"/>
                        <TableView fx:id="boardTable" prefHeight="385.0" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6D6D6; -fx-border-width: 1; -fx-control-inner-background: #FFFFFF; -fx-control-inner-background-alt: #F7F7F7; -fx-selection-bar: #FFEDAE; -fx-selection-bar-non-focused: #FFEDAE; -fx-accent: #FFCC29; -fx-focus-color: #D0A00F;">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="92.0"/>
                                <TableColumn fx:id="titleColumn" text="Título" prefWidth="244.0"/>
                                <TableColumn fx:id="modalityColumn" text="Modalidad" prefWidth="166.0"/>
                                <TableColumn fx:id="approvalDateColumn" text="Aprobación" prefWidth="112.0"/>
                                <TableColumn fx:id="earliestDateColumn" text="Presentación desde" prefWidth="130.0"/>
                                <TableColumn fx:id="deadlineColumn" text="Fecha máxima" prefWidth="112.0"/>
                                <TableColumn fx:id="remainingDaysColumn" text="Días restantes" prefWidth="105.0"/>
                                <TableColumn fx:id="deadlineStatusColumn" text="Estado del plazo" prefWidth="180.0"/>
                            </columns>
                            <placeholder>
                                <Label text="No hay trabajos de grado aprobados para mostrar." style="-fx-text-fill: #5C5C5C;"/>
                            </placeholder>
                        </TableView>
                        <VBox spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 9; -fx-border-color: #DEDEDE; -fx-border-width: 1; -fx-border-radius: 9;">
                            <padding><Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                            <children>
                                <Label text="Detalle del expediente seleccionado" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                                    <font><Font name="System Bold" size="17.0"/></font>
                                </Label>
                                <TextArea fx:id="detailsArea" editable="false" wrapText="true" prefRowCount="6" prefHeight="150.0" promptText="Selecciona un trabajo de grado en la tabla para ver sus datos." style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="12.0" alignment="CENTER_LEFT" style="-fx-background-color: #47484B;">
            <padding><Insets top="12.0" right="24.0" bottom="12.0" left="24.0"/></padding>
            <children>
                <Label fx:id="statusLabel" text="Cargando tablero..." wrapText="true" HBox.hgrow="ALWAYS" style="-fx-text-fill: #FFFFFF;"/>
                <Button fx:id="closeButton" text="Cerrar ventana" onAction="#onClose" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
