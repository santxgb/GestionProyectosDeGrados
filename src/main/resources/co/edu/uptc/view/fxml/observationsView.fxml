<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefHeight="740.0" prefWidth="1080.0" fx:controller="co.edu.uptc.controller.fx.ObservationsFxController" style="-fx-font-family: System; -fx-font-size: 13px; -fx-background-color: #F5F5F5; -fx-focus-color: #D0A00F; -fx-faint-focus-color: rgba(208,160,15,0.15);">
    <top>
        <VBox spacing="6.0" style="-fx-background-color: #FFCC29; -fx-border-color: transparent transparent #E4B11D transparent; -fx-border-width: 0 0 3 0;">
            <padding>
                <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
            </padding>
            <children>
                <Label text="Observaciones de seguimiento" style="-fx-text-fill: #212121; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="25.0"/></font>
                </Label>
                <Label text="Consulta las observaciones iniciales y actualiza solo el seguimiento de los trabajos aprobados." wrapText="true" style="-fx-text-fill: #363636;"/>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #F5F5F5; -fx-background: #F5F5F5;">
            <content>
                <VBox spacing="12.0" style="-fx-background-color: #F5F5F5;">
                    <padding>
                        <Insets top="20.0" right="30.0" bottom="18.0" left="30.0"/>
                    </padding>
                    <children>
                        <Label fx:id="summaryLabel" text="Trabajos aprobados: 0" style="-fx-text-fill: #5C5C5C;"/>
                        <TableView fx:id="workTable" prefHeight="280.0" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6D6D6; -fx-border-width: 1; -fx-control-inner-background: #FFFFFF; -fx-control-inner-background-alt: #F7F7F7; -fx-selection-bar: #FFEDAE; -fx-selection-bar-non-focused: #FFEDAE; -fx-accent: #FFCC29; -fx-focus-color: #D0A00F;">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="125.0"/>
                                <TableColumn fx:id="titleColumn" text="Título del trabajo" prefWidth="460.0"/>
                                <TableColumn fx:id="approvalDateColumn" text="Aprobación" prefWidth="160.0"/>
                                <TableColumn fx:id="deadlineColumn" text="Fecha máxima" prefWidth="160.0"/>
                            </columns>
                        </TableView>
                        <Label fx:id="selectedWorkLabel" text="Selecciona un trabajo de grado aprobado en la tabla." wrapText="true" style="-fx-text-fill: #303033; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="14.0"/></font>
                        </Label>
                        <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS" prefWidth="490.0">
                                    <children>
                                        <Label text="Observaciones iniciales de la propuesta (solo lectura)" wrapText="true" style="-fx-text-fill: #303033; -fx-font-weight: bold;"/>
                                        <TextArea fx:id="proposalObservationsArea" editable="false" prefHeight="180.0" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-background-color: #F1F1F1; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525; -fx-control-inner-background: #F1F1F1;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS" prefWidth="490.0">
                                    <children>
                                        <Label text="Observaciones del trabajo de grado (editables)" wrapText="true" style="-fx-text-fill: #303033; -fx-font-weight: bold;"/>
                                        <TextArea fx:id="followUpObservationsArea" disable="true" prefHeight="180.0" wrapText="true" VBox.vgrow="ALWAYS" promptText="Escribe aquí el seguimiento del trabajo de grado..." style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C9C9C9; -fx-border-radius: 5; -fx-border-width: 1; -fx-text-fill: #252525;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Label text="Guardar modifica únicamente el seguimiento del trabajo. Las observaciones iniciales se conservan." wrapText="true" style="-fx-text-fill: #5C5C5C;"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="10.0" style="-fx-background-color: #47484B;">
            <padding>
                <Insets top="12.0" right="30.0" bottom="14.0" left="30.0"/>
            </padding>
            <children>
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <children>
                        <Button text="Actualizar listado" onAction="#onRefresh" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                        <Button fx:id="restoreButton" text="Restaurar texto guardado" disable="true" onAction="#onRestore" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                        <Button fx:id="saveButton" text="Guardar seguimiento" disable="true" onAction="#onSaveObservations" mnemonicParsing="false" style="-fx-background-color: #FFCC29; -fx-background-radius: 6; -fx-border-color: #E3B321; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #212121; -fx-cursor: hand; -fx-padding: 7 13 7 13; -fx-font-weight: bold;"/>
                        <Button fx:id="closeButton" text="Cerrar" onAction="#onClose" mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #C7C7C7; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #303033; -fx-cursor: hand; -fx-padding: 7 13 7 13;"/>
                    </children>
                </HBox>
                <Label fx:id="statusLabel" text="Selecciona un trabajo para consultar sus observaciones." wrapText="true" style="-fx-text-fill: #FFFFFF;"/>
            </children>
        </VBox>
    </bottom>
</BorderPane>
